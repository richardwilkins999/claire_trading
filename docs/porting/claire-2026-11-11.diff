+
+@needs_js
+def test_unrealised_total_says_what_it_leaves_out(js):
+    whole, part, none, empty, old = js["upl"]
+    assert whole == {"value": 100, "unpriced": 0, "note": ""}
+    assert part == {"value": 120.5, "unpriced": 1, "note": "1 of 2 positions unpriced"}
