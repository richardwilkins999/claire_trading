+def test_timeout_setting_is_read_from_the_environment(monkeypatch,
+                                                      deadline_now):
+    monkeypatch.setenv("CLAIRE_SDK_TIMEOUT_S", "120")
+    with pytest.raises(claude_sdk.SdkTimeout, match="after 120s"):
+        claude_sdk.SdkChat("m", _query=hung()).invoke("x")
+    assert deadline_now == [120]
+
+
+# ── the cap ──────────────────────────────────────────────────────────────
+def test_gate_queues_past_the_limit():
+    g = claude_sdk.Gate(2)
+    g.acquire()
+    g.acquire()
+    got = threading.Event()
+
+    def third():
+        with g.slot():
+            got.set()
+    t = threading.Thread(target=third, daemon=True)
+    t.start()
+    until(lambda: g.waiting == 1, "the third caller queued")
+    assert not got.is_set() and g.active == 2
+    g.release()
+    t.join(5)
+    assert got.is_set() and (g.active, g.waiting) == (1, 0)
+
+
+def test_gate_lets_a_person_ahead_of_queued_background_work():
+    g = claude_sdk.Gate(1)
+    g.acquire()
+    order = []
+
+    def caller(name, urgent):
+        g.acquire(urgent=urgent)
+        order.append(name)
+    bg = threading.Thread(target=caller, args=("pipeline", False), daemon=True)
+    bg.start()
+    until(lambda: g.waiting == 1, "pipeline call queued")
+    chat = threading.Thread(target=caller, args=("chat", True), daemon=True)
+    chat.start()
+    until(lambda: g.waiting == 2, "chat queued behind it")
+    g.release()
+    chat.join(5)
+    assert order == ["chat"] and g.waiting == 1
+    g.release()
+    bg.join(5)
+    assert order == ["chat", "pipeline"]
+
+
+def test_gate_releases_its_slot_when_the_work_fails():
+    g = claude_sdk.Gate(1)
+    with pytest.raises(ValueError):
+        with g.slot():
+            raise ValueError("boom")
+    assert g.active == 0
+
+
+def test_conversations_past_the_cap_wait_their_turn(own_gate):
+    g = own_gate(1)
+    go, state = threading.Event(), {"running": 0, "peak": 0, "started": 0}
+
+    async def q(*, prompt, options):
+        state["running"] += 1
+        state["started"] += 1
+        state["peak"] = max(state["peak"], state["running"])
+        await asyncio.to_thread(go.wait)
+        state["running"] -= 1
+        yield result(result=f"answer to {prompt}")
+
+    answers, errors = [], []
+
+    def ask(prompt):
+        try:
+            answers.append(claude_sdk.SdkChat("m", _query=q).invoke(
+                prompt).content)
+        except Exception as e:              # noqa: BLE001 — asserted below
+            errors.append(e)
+    threads = [threading.Thread(target=ask, args=(p,), daemon=True)
+               for p in ("a", "b", "c")]
+    for t in threads:
+        t.start()
+    until(lambda: g.waiting == 2 and state["started"] == 1,
+          "one running, two queued")
+    go.set()
+    for t in threads:
+        t.join(5)
+    assert errors == [] and sorted(answers) == [
+        "answer to a", "answer to b", "answer to c"]    # queued, not refused
+    assert state["peak"] == 1 and (g.active, g.waiting) == (0, 0)
+
+
+def test_every_kind_of_conversation_takes_a_slot(own_gate):
+    g = own_gate(3)
+    seen = []
+
+    async def q(*, prompt, options):
+        seen.append(g.active)
+        yield result(result="ok")
+    chat = claude_sdk.SdkChat("m", _query=q)
+    chat.invoke("x")
+    claude_sdk.run_tool_loop(chat, "S", "T", [])
+    list(claude_sdk.stream_chat(chat, "S", "hi", []))
+    assert seen == [1, 1, 1] and g.active == 0
+
+
+def test_a_timed_out_conversation_gives_its_slot_back(own_gate, deadline_now):
+    g = own_gate(1)
+    with pytest.raises(claude_sdk.SdkTimeout):
+        claude_sdk.SdkChat("m", _query=hung()).invoke("x")
+    assert g.active == 0
+    assert claude_sdk.SdkChat("m", _query=scripted(
+        result(result="ok"))).invoke("x").content == "ok"
+
+
+def test_a_queued_run_is_metered_from_when_it_starts(conn, own_gate):
+    g = own_gate(1)
+    g.acquire()                             # the only slot is taken
+    base = registry.build_llm(conn, "claude_max", "claude-sonnet-5")
+    base._query = scripted(result(result="ok"))
+    llm = base.with_config(
+        callbacks=[registry.MeterCallback(conn, "bull", "wi_1")])
+    t = threading.Thread(target=llm.invoke, args=("x",), daemon=True)
+    t.start()
+    until(lambda: g.waiting == 1, "the call queued")
+    assert conn.execute("SELECT COUNT(*) FROM agent_runs").fetchone()[0] == 0
+    g.release()
+    t.join(5)
+    assert conn.execute("SELECT status FROM agent_runs").fetchone()[0] == "ok"
+
+
+def test_cap_setting(monkeypatch):
+    monkeypatch.setattr(claude_sdk, "_gate", None)
+    monkeypatch.delenv("CLAIRE_SDK_MAX_CONCURRENT", raising=False)
+    assert claude_sdk.gate().limit == 4
+    assert claude_sdk.gate() is claude_sdk.gate()       # one per process
+    for raw, limit in (("2", 2), ("0", 4), ("many", 4), ("", 4)):
+        monkeypatch.setattr(claude_sdk, "_gate", None)
+        monkeypatch.setenv("CLAIRE_SDK_MAX_CONCURRENT", raw)
+        assert claude_sdk.gate().limit == limit
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..47dd016
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,232 @@
+"""Web search without a key (REVIEW-2026-11-11 B4).
+
+The keyless path scraped DuckDuckGo, which answers programs with its bot
+check — every search came back empty and the news agent worked from
+nothing. It now reads two published news feeds, and an outage raises
+instead of looking like "no results".
+"""
+import json
+
+import httpx
+import pytest
+
+from app.tools import search
+from app.tools.search import SearchError, news_search, web_search
+
+BING = b"""<?xml version="1.0" encoding="utf-8"?>
+<rss version="2.0" xmlns:News="https://www.bing.com/news/search"><channel>
+<title>nvidia - BingNews</title>
+<item><title>Nvidia &amp; the chip rally</title>
+<link>http://www.bing.com/news/apiclick.aspx?ref=FexRss&amp;aid=&amp;tid=abc&amp;url=https%3a%2f%2fexample.com%2fnews%2fnvda%3fa%3d1&amp;c=1</link>
+<description>Shares &lt;b&gt;rose&lt;/b&gt; 4%   after results.</description>
+<pubDate>Tue, 10 Nov 2026 15:08:02 GMT</pubDate></item>
+<item><title>Second story</title><link>https://example.org/direct</link>
+<description>Plain link.</description>
+<pubDate>Tue, 10 Nov 2026 14:00:00 GMT</pubDate></item>
+<item><title>Third</title><link>https://example.org/3</link>
+<description>x</description></item>
+</channel></rss>"""
+
+GOOGLE = b"""<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0"><channel><title>"nvidia" - Google News</title>
+<item><title>Chip stocks rally - CNBC</title>
+<link>https://news.google.com/rss/articles/CBMiABC</link>
+<pubDate>Tue, 10 Nov 2026 13:19:13 GMT</pubDate>
+<description>&lt;a href="x"&gt;Chip stocks rally&lt;/a&gt;</description>
+<source url="https://www.cnbc.com">CNBC</source></item>
+</channel></rss>"""
+
+
+class Feeds:
+    """A fake httpx client: host fragment -> bytes, status code or error."""
+    def __init__(self, **by_host):
+        self.by_host, self.calls = by_host, []
+
+    def get(self, url, params=None, headers=None):
+        self.calls.append((url, params, headers))
+        for frag, answer in self.by_host.items():
+            if frag in url:
+                if isinstance(answer, Exception):
+                    raise answer
+                req = httpx.Request("GET", url)
+                if isinstance(answer, int):
+                    return httpx.Response(answer, request=req, content=b"")
+                return httpx.Response(200, request=req, content=answer)
+        raise AssertionError(f"unexpected URL {url}")
+
+    def post(self, *a, **k):
+        raise AssertionError("Tavily must not be called without a key")
+
+
+def test_keyless_search_reads_the_news_feed():
+    c = Feeds(bing=BING)
+    hits = web_search("Nvidia earnings", env={}, _client=c)
+    assert [h["title"] for h in hits] == ["Nvidia & the chip rally",
+                                          "Second story", "Third"]
+    # the publisher's own address, not Bing's click-through link
+    assert hits[0]["url"] == "https://example.com/news/nvda?a=1"
+    assert hits[1]["url"] == "https://example.org/direct"
+    assert hits[0]["snippet"] == "Shares rose 4% after results."
+    assert hits[0]["published"].startswith("Tue, 10 Nov 2026")
+    url, params, headers = c.calls[0]
+    assert params == {"q": "Nvidia earnings", "format": "rss"}
+    # asks under its own name — no browser impersonation
+    assert headers["User-Agent"].startswith("claire-desk/")
+    assert "duckduckgo" not in json.dumps([u for u, _, _ in c.calls])
+
+
+def test_max_results_is_respected():
+    assert len(news_search("x", max_results=2, _client=Feeds(bing=BING))) == 2
+
+
+def test_second_feed_is_used_when_the_first_fails():
+    c = Feeds(bing=503, google=GOOGLE)
+    hits = news_search("nvidia", _client=c)
+    assert hits[0]["title"] == "Chip stocks rally - CNBC"
+    assert hits[0]["snippet"] == "CNBC" and hits[0]["source"] == "google-news"
+    assert "redirect" in hits[0]["note"]        # tells the agent not to fetch
+    assert len(c.calls) == 2
+
+
+def test_second_feed_is_used_when_the_first_is_empty():
+    empty = b"<rss><channel><title>t</title></channel></rss>"
+    hits = news_search("nvidia", _client=Feeds(bing=empty, google=GOOGLE))
+    assert hits and hits[0]["source"] == "google-news"
+
+
+def test_an_outage_raises_instead_of_looking_like_no_results():
+    c = Feeds(bing=httpx.ConnectError("refused"), google=429)
+    with pytest.raises(SearchError, match="unavailable") as e:
+        web_search("nvidia", env={}, _client=c)
+    assert "bing-news" in str(e.value) and "google-news" in str(e.value)
+
+
+def test_no_results_is_an_empty_list_not_an_error():
+    empty = b"<rss><channel><title>t</title></channel></rss>"
+    assert news_search("zzzz", _client=Feeds(bing=empty, google=empty)) == []
+    # one feed down, the other answered with nothing: still "no results"
+    assert news_search("zzzz", _client=Feeds(bing=500, google=empty)) == []
+
+
+@pytest.mark.parametrize("body", [
+    b"<html><body>Please verify you are human</body></html>",   # a bot check
+    b"not xml at all <<<",
+    b'<?xml version="1.0"?><!DOCTYPE r [<!ENTITY a "aaaa">]><rss>&a;</rss>',
+    b"<rss>" + b"x" * (search.MAX_FEED_BYTES + 1) + b"</rss>",
+])
+def test_a_feed_that_is_not_plain_rss_counts_as_unreachable(body):
+    """A bot-check page is a refusal. Reading it as "no news found" is the
+    very failure this replaced, so it must raise, not return []."""
+    with pytest.raises(SearchError, match="unavailable"):
+        news_search("nvidia", _client=Feeds(bing=body, google=body))
+    # and one good feed is still enough
+    hits = news_search("nvidia", _client=Feeds(bing=body, google=GOOGLE))
+    assert hits[0]["source"] == "google-news"
+
+
+def test_tavily_is_still_used_when_a_key_is_set():
+    class Tavily:
+        def post(self, url, json=None):
+            assert url == "https://api.tavily.com/search"
+            assert json["api_key"] == "tv-test" and json["max_results"] == 3
+            return httpx.Response(
+                200, request=httpx.Request("POST", url),
+                json={"results": [{"title": "T", "url": "https://t.example",
+                                   "content": "c" * 900}]})
+
+        def get(self, *a, **k):
+            raise AssertionError("the feeds are not asked when a key is set")
+    hits = web_search("q", max_results=3, env={"TAVILY_API_KEY": "tv-test"},
+                      _client=Tavily())
+    assert hits == [{"title": "T", "url": "https://t.example",
+                     "snippet": "c" * 400}]
+
+
+def test_env_none_means_the_process_environment(monkeypatch):
+    """lc_tools and the screener passed `env or {}`, so a key in claire.env
+    was never seen. None now reads os.environ."""
+    seen = {}
+
+    class C:
+        def post(self, url, json=None):
+            seen["key"] = json["api_key"]
+            return httpx.Response(200, request=httpx.Request("POST", url),
+                                  json={"results": []})
+    monkeypatch.setenv("TAVILY_API_KEY", "tv-from-env")
+    web_search("q", _client=C())
+    assert seen["key"] == "tv-from-env"
+
+
+def test_screener_catalyst_check_uses_the_process_environment(monkeypatch):
+    from app import screener
+    seen = {}
+
+    def fake(q, max_results=8, env=None, _client=None):
+        seen.update(q=q, env=env, n=max_results)
+        return [{"title": "Nvidia beats", "url": "u", "snippet": ""}]
+    monkeypatch.setattr(search, "web_search", fake)
+    notes = screener.catalyst_notes(
+        [{"ticker": "NVDA", "name": "Nvidia", "scans": ["a"]}])
+    assert notes == {"NVDA": "Nvidia beats"}
+    assert seen["env"] is None and seen["n"] == 3   # not {} any more
+
+
+def test_real_search_is_blocked_in_the_suite():
+    with pytest.raises(SearchError, match="offline test"):
+        web_search("anything", env={})
+
+
+# ── fetch_page: the article, not the menu (REVIEW-2026-11-11 §4.1.5) ────────
+PAGE = """<html><head><title>Nvidia beats on revenue | Example News</title>
+<style>.x{color:red}</style><script>var tracking = "do not show me";</script>
+</head><body>
+<header><a href="/">Home</a><a href="/markets">Markets</a></header>
+<nav><ul><li>World</li><li>Business</li><li>Most read today</li></ul></nav>
+<aside>Subscribe to our newsletter &amp; never miss a story</aside>
+<main><article><h1>Nvidia beats on revenue</h1>
+<p>Nvidia reported third-quarter revenue of $35.1&nbsp;billion, up 94% from a
+year earlier, the company said on Wednesday.</p>
+<p>Data-centre sales were $30.8 billion. """ + "The outlook was raised. " * 30 + """</p>
+<form><input name="email"><button>Sign up</button></form>
+</article></main>
+<footer>&copy; Example News. Terms. Privacy. Cookie settings.</footer>
+</body></html>"""
+
+
+def test_main_text_keeps_the_article_and_drops_the_page_furniture():
+    from app.tools.search import main_text
+    text = main_text(PAGE)
+    assert text.startswith("Nvidia beats on revenue")
+    assert "revenue of $35.1 billion, up 94%" in text.replace("\xa0", " ")
+    assert "Data-centre sales were $30.8 billion." in text
+    for junk in ("Most read today", "Subscribe to our newsletter", "tracking",
+                 "color:red", "Cookie settings", "Sign up", "Markets"):
+        assert junk not in text, junk
+    assert "<" not in text and "&amp;" not in text
+
+
+def test_main_text_falls_back_to_the_body_without_its_navigation():
+    from app.tools.search import main_text
+    page = ("<html><body><nav>Menu one two</nav><div><p>Short note: DBS "
+            "reported a 5% fall in profit.</p></div><footer>Legal</footer>"
+            "</body></html>")
+    assert main_text(page) == "Short note: DBS reported a 5% fall in profit."
+    # an <article> too short to be the content does not hide the page
+    page = ("<body><article>Ad</article><div>" + "Real paragraph. " * 40
+            + "</div></body>")
+    assert main_text(page).count("Real paragraph.") == 40
+    assert main_text("plain text, no markup") == "plain text, no markup"
+
+
+def test_fetch_page_returns_the_article_text():
+    from app.tools.search import fetch_page
+
+    class C:
+        def get(self, url, follow_redirects=False):
+            return httpx.Response(200, request=httpx.Request("GET", url),
+                                  text=PAGE)
+    out = fetch_page("https://news.example.com/nvda", _client=C(),
+                     _resolve=lambda h, p, proto=0: [(2, 1, 6, "", ("93.184.216.34", p))],
+                     max_chars=300)
+    assert out.startswith("Nvidia beats on revenue") and len(out) <= 300
+    assert "Most read today" not in out
diff --git a/tests/test_server_efficiency.py b/tests/test_server_efficiency.py
new file mode 100644
index 0000000..83a87c8
--- /dev/null
+++ b/tests/test_server_efficiency.py
@@ -0,0 +1,216 @@
+"""Server-side efficiency (REVIEW-2026-11-11 §3.5, §4.2): compressed
+answers, pages the browser can revalidate, and slow scheduled jobs that no
+longer hold up the money-path ones."""
+import gzip
+import json
+import threading
+import time
+
+import httpx
+
+from app.scheduler import Scheduler
+from tests.test_dashboards import paired, web  # noqa: F401 — fixture
+from tests.test_watcher_trailing import T0, _desk
+from decimal import Decimal
+
+
+# ── gzip and ETag ───────────────────────────────────────────────────────────
+def test_large_answers_are_gzipped_when_the_client_accepts_it(web):  # noqa: F811
+    base, _ = web
+    raw = httpx.get(base + "/nav.js", headers={"Accept-Encoding": "identity"})
+    assert "content-encoding" not in raw.headers
+    with httpx.Client(headers={"Accept-Encoding": "gzip"}) as c:
+        with c.stream("GET", base + "/nav.js") as r:
+            packed = b"".join(r.iter_raw())
+            assert r.headers["content-encoding"] == "gzip"
+            assert r.headers["vary"] == "Accept-Encoding"
+            assert int(r.headers["content-length"]) == len(packed)
+    assert gzip.decompress(packed) == raw.content       # same bytes
+    assert len(packed) < len(raw.content) / 2
+
+
+def test_small_answers_are_left_alone(web):                  # noqa: F811
+    base, _ = web
+    r = httpx.get(base + "/api/nav-state")
+    assert "content-encoding" not in r.headers and r.json()["pending"] == 1
+
+
+def test_api_json_is_gzipped_too_and_still_parses(web):      # noqa: F811
+    base, _ = web
+    with paired(base) as c:
+        r = c.get("/api/agent-graph")                   # a large payload
+    assert r.headers.get("content-encoding") == "gzip" and "agents" in r.json()
+
+
+def test_pages_and_scripts_revalidate_with_an_etag(web):     # noqa: F811
+    base, _ = web
+    for path in ("/", "/nav.js", "/style.css"):
+        first = httpx.get(base + path)
+        etag = first.headers["etag"]
+        assert first.headers["cache-control"] == "no-cache"
+        again = httpx.get(base + path, headers={"If-None-Match": etag})
+        assert again.status_code == 304 and again.content == b""
+        changed = httpx.get(base + path, headers={"If-None-Match": '"old"'})
+        assert changed.status_code == 200 and changed.content == first.content
+
+
+# ── scheduler ───────────────────────────────────────────────────────────────
+def _sched(conn, runners, **kw):
+    conn.execute("DELETE FROM schedules")
+    for job in runners:
+        conn.execute(
+            "INSERT INTO schedules (job, description, spec, enabled, runs_in)"
+            " VALUES (?,?,?,1,'claire-api')",
+            (job, job, '{"type": "interval", "minutes": 1}'))
+    return Scheduler(conn, runners, clock=lambda: T0, **kw)
+
+
+def _result(conn, job):
+    return json.loads(conn.execute(
+        "SELECT last_result FROM schedules WHERE job=?", (job,)).fetchone()[0])
+
+
+def test_a_slow_job_no_longer_holds_up_the_custodian():
+    conn, _, _ = _desk(Decimal("100"))
+    release, order = threading.Event(), []
+
+    def screen(spec):
+        release.wait(5)                     # a model call that takes a while
+        order.append("analysis_us")
+        return {"started": 1}
+
+    def custodian(spec):
+        order.append("custodian")
+        return {"fills": 0}
+    s = _sched(conn, {"analysis_us": screen, "custodian": custodian})
+    t0 = time.monotonic()
+    fired = s.tick()
+    assert time.monotonic() - t0 < 2        # the tick did not wait for it
+    assert set(fired) == {"analysis_us", "custodian"}
+    assert order == ["custodian"]           # ran while the slow job was busy
+    assert _result(conn, "analysis_us")["running"] is True
+    release.set()
+    s.wait_idle()
+    assert order == ["custodian", "analysis_us"]
+    assert _result(conn, "analysis_us") == {"started": 1}
+    assert _result(conn, "custodian") == {"fills": 0}
+
+
+def test_a_background_job_is_not_started_twice():
+    conn, _, _ = _desk(Decimal("100"))
+    release, runs = threading.Event(), []
+
+    def scan(spec):
+        runs.append(1)
+        release.wait(5)
+        return {}
+    now = {"t": T0}
+    s = _sched(conn, {"event_scan": scan})
+    s.clock = lambda: now["t"]
+    assert s.tick() == ["event_scan"]
+    now["t"] += 600                         # due again, still running
+    assert s.tick() == []
+    release.set()
+    s.wait_idle()
+    assert len(runs) == 1
+    now["t"] += 600
+    assert s.tick() == ["event_scan"]       # free again
+    s.wait_idle()
+
+
+def test_a_failing_background_job_is_recorded_and_the_worker_survives():
+    conn, _, _ = _desk(Decimal("100"))
+
+    def boom(spec):
+        raise RuntimeError("model unavailable")
+    s = _sched(conn, {"maintenance": boom, "analysis_eu": lambda spec: {"ok": 1}})
+    s.tick()
+    s.wait_idle()
+    assert "model unavailable" in _result(conn, "maintenance")["error"]
+    assert _result(conn, "analysis_eu") == {"ok": 1}
+
+
+def test_money_path_jobs_stay_inline_and_in_order():
+    conn, _, _ = _desk(Decimal("100"))
+    seen = []
+    s = _sched(conn, {
+        "custodian": lambda spec: seen.append(threading.current_thread().name) or {},
+        "price_triggers": lambda spec: seen.append(threading.current_thread().name) or {},
+        "reconcile": lambda spec: seen.append(threading.current_thread().name) or {}})
+    s.tick()
+    here = threading.current_thread().name
+    assert seen == [here, here, here]       # this thread, one after another
+    assert not any(s._is_background(j)
+                   for j in ("custodian", "price_triggers", "reconcile"))
+    assert all(s._is_background(j) for j in
+               ("analysis_asia", "analysis_us", "event_scan", "maintenance"))
+
+
+# ── health rows only grow when something changes (§4.3) ─────────────────────
+def test_identical_reports_move_one_row_forward():
+    from app import health
+    conn, _, _ = _desk(Decimal("100"))
+    report = {"fills": 0, "flags": []}
+    assert health.record(conn, "custodian", "ok", report, T0) is True
+    for i in range(1, 50):                  # four hours of nothing happening
+        assert health.record(conn, "custodian", "ok", report, T0 + i * 300) is False
+    rows = conn.execute("SELECT checked_at, ok FROM service_health WHERE"
+                        " service='custodian'").fetchall()
+    assert len(rows) == 1 and rows[0]["checked_at"] == T0 + 49 * 300   # heartbeat
+    # a change is a new row; so is the recovery
+    assert health.record(conn, "custodian", "degraded",
+                         {"fills": 0, "flags": ["x"]}, T0 + 15000) is True
+    assert health.record(conn, "custodian", "ok", report, T0 + 15300) is True
+    assert [r["ok"] for r in conn.execute(
+        "SELECT ok FROM service_health WHERE service='custodian'"
+        " ORDER BY rowid")] == ["ok", "degraded", "ok"]
+    # services do not share a row
+    assert health.record(conn, "watcher", "ok", report, T0) is True
+
+
+def test_the_custodian_and_watcher_use_it():
+    from app.custodian import Custodian
+    from app.accounting.money import to_micro
+    conn, w, _ = _desk(Decimal("100"))
+    c = Custodian(conn, w.repo, {}, resume_post=lambda b: (200, {}),
+                  account_broker=lambda a: "alpaca",
+                  fx_rate_for=lambda i, a: to_micro("1"), clock=lambda: T0)
+    for _ in range(4):
+        c.run_once()
+        w.tick()
+    counts = dict(conn.execute("SELECT service, COUNT(*) FROM service_health"
+                               " GROUP BY service").fetchall())
+    assert counts == {"custodian": 1, "watcher": 1}
+
+
+# ── Twelve Data: the budget is credits (§4.1 item 6) ────────────────────────
+def test_a_batch_costs_one_credit_per_symbol():
+    from app.tools.market import Market, build_market
+
+    class P:
+        calls = []
+
+        def supports(self, s):
+            return True
+
+        def quote(self, syms):
+            P.calls.append(list(syms))
+            return {s: {"symbol": s, "price": Decimal("10"), "stale": False,
+                        "src": "primary"} for s in syms}
+    m = Market(_get=lambda *a, **k: 1 / 0, primary=P(), clock=lambda: 1000,
+               tv_quotes=lambda syms: {s: {"symbol": s, "price": Decimal("9"),
+                                           "stale": False, "src": "tv"}
+                                       for s in syms})
+    m.PRIMARY_PER_MIN = 4
+    assert m.spark(["A", "B", "C"])["A"]["src"] == "primary"    # 3 of 4 spent
+    assert len(m._primary_calls) == 3
+    # two more would overdraw the minute: not sent, the free chain answers
+    out = m.spark(["D", "E"])
+    assert out["D"]["src"] == "tv" and P.calls == [["A", "B", "C"]]
+    assert m.spark(["F"])["F"]["src"] == "primary"              # 1 left
+    assert m._primary_ok() is False                             # none left
+    # each of the two processes takes half the plan's quota
+    assert build_market({"TWELVEDATA_API_KEY": "k", "CLAIRE_NO_SAXO_CHARTS": "1"}
+                        ).PRIMARY_PER_MIN == 4
+    assert build_market({"TWELVEDATA_API_KEY": "k", "CLAIRE_NO_SAXO_CHARTS": "1",
+                         "TWELVEDATA_CREDITS_PER_MIN": "55"}).PRIMARY_PER_MIN == 27
