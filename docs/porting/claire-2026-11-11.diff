+def _tag_at(src, i):
+    quoted = False
+    for j in range(i, min(len(src), i + 2500)):
+        c = src[j]
+        if c == '"':
+            quoted = not quoted
+        elif c == ">" and not quoted:
+            return src[i:j + 1]
+    return src[i:i + 300]
