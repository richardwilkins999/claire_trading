+    assert out.getvalue().count("once") == 1
+
+
+def test_http_libraries_cannot_log_request_urls(fresh_setup):
+    """httpx logs every request URL at INFO — and the desk's URLs carry the
+    Twelve Data key and the Telegram bot token."""
