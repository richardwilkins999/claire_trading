-    m = str(model or "")
-    if not m.startswith("claude-"):
-        return m or "unknown"
-    words, nums = [], []
-    for part in m[len("claude-"):].split("-"):
-        if part.isdigit() and len(part) <= 2:
-            nums.append(part)
-        elif not part.isdigit():          # a date suffix is dropped
