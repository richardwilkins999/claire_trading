# Copy to claire.env, chmod 600. Real keys never enter git or desk.db —
# providers reference these by NAME via api_key_ref (DESIGN.md §8).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TAVILY_API_KEY=
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
SAXO_SIM_TOKEN=
# Shared secret for :7788/internal/resume (DESIGN.md §10)
CLAIRE_INTERNAL_SECRET=
# Saxo: two independent OAuth apps (PKCE) — one per environment — each with
# its own sign-in (bin/saxo login sim|live), renewal and alerts. Register the
# redirect URL on each app with no port.
SAXO_SIM_ACCOUNT_ID=
SAXO_SIM_APP_KEY=
SAXO_SIM_APP_URL=http://localhost/claire-saxo
SAXO_LIVE_ACCOUNT_ID=
SAXO_LIVE_APP_KEY=
SAXO_LIVE_APP_URL=http://localhost/claire-saxo
# only for an app with grant type "code" (PKCE needs no secret)
SAXO_SIM_APP_SECRET=
SAXO_LIVE_APP_SECRET=

# ── Saxo SIM execution (paper money, real Saxo order handling) ─────────────
# Route the saxo-paper account to Saxo SIM instead of the in-process sim.
SAXO_SIM_EXECUTION=
SAXO_SIM_ACCOUNT_KEY=

# ── REAL-MONEY trading on Saxo — DESIGN.md §22. Leave empty to keep it off.
# Setting this alone trades nothing: you must also `bin/claire live setup`,
# `bin/claire live arm` (terminal, typed confirmation) and approve each trade
# by typing LIVE. Remove it and restart to switch live trading off entirely.
CLAIRE_LIVE_TRADING=

# ── Dashboards ──────────────────────────────────────────────────────────────
# Listen address. 127.0.0.1 (default) = this PC only. 0.0.0.0 puts the pages
# on your network: anyone on it can READ the desk; every action still needs
# the dashboard key.
CLAIRE_DASHBOARD_BIND=
# Extra host names the dashboards answer to (comma-separated), e.g. a DNS
# alias for this box. Loopback, the hostname and the LAN IP are always allowed.
CLAIRE_DASHBOARD_HOSTS=
# Generated on first start and appended here if empty. Paste it into a
# browser once (the key icon in the menu) to be allowed to act.
CLAIRE_DASHBOARD_KEY=
# The address to put in Telegram links, if this PC is reached by another name.
CLAIRE_DASHBOARD_URL=
# Where the Telegram bot token and chat id live (default: ~/bob/telegram.env).
CLAIRE_TELEGRAM_ENV=

# ── Market data ─────────────────────────────────────────────────────────────
# Twelve Data: the preferred quote/chart source when a key is set.
TWELVEDATA_API_KEY=
# Your plan's credits per minute (free tier: 8). The two services share it.
TWELVEDATA_CREDITS_PER_MIN=
# Set to 1 only on a plan that covers non-US exchanges (Pro and above).
TWELVEDATA_ALL_EXCHANGES=
# Interactive Brokers gateway as the data source instead (any value enables).
IBKR_ENABLED=
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
# Saxo charts are the fallback when Yahoo refuses: which sign-in to use
# (sim, default, or live); set CLAIRE_NO_SAXO_CHARTS=1 to turn them off.
CLAIRE_SAXO_CHART_ENV=
CLAIRE_NO_SAXO_CHARTS=

# ── Model calls (Claude Agent SDK) ──────────────────────────────────────────
# Seconds one research tool loop may run before it is stopped (default 600);
# also a ceiling for chat and structured calls (default 300 each).
CLAIRE_SDK_TIMEOUT_S=
# How many model conversations may run at once (default 4); the rest queue.
CLAIRE_SDK_MAX_CONCURRENT=
# 1 = an analyst's research and its report use ONE session (experimental).
CLAIRE_SDK_ANALYST_ONE_SESSION=

# ── Operations ──────────────────────────────────────────────────────────────
# DEBUG, INFO (default), WARNING. Logs: var/log/api.log, var/log/dashboards.log
CLAIRE_LOG_LEVEL=
# Seconds `bin/claire stop` waits for work in flight (default 300).
CLAIRE_DRAIN_TIMEOUT=
